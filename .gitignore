# ------------- Global ignore ------------- #
# OS
.DS_Store

# ------------- Frontend ignore ------------- #
apps/frontend/node_modules
apps/frontend/dist
apps/frontend/dist-ssr
apps/frontend/count.txt
apps/frontend/.env
apps/frontend/*.local
apps/frontend/.nitro
apps/frontend/.tanstack
apps/frontend/.wrangler
apps/frontend/.output
apps/frontend/.vinxi
apps/frontend/todos.json
apps/frontend/.vscode
apps/frontend/.vscode/*
!apps/frontend/.vscode/settings.json
!apps/frontend/.vscode/tasks.json
!apps/frontend/.vscode/launch.json
!apps/frontend/.vscode/extensions.json

# ------------- Backend ignore ------------- #

# compiled output
apps/backend/dist
apps/backend/node_modules
apps/backend/build

# Logs
apps/backend/logs
apps/backend/*.log
apps/backend/npm-debug.log*
apps/backend/pnpm-debug.log*
apps/backend/yarn-debug.log*
apps/backend/yarn-error.log*
apps/backend/lerna-debug.log*

# Tests
apps/backend/coverage
apps/backend/.nyc_output

# IDEs and editors
apps/backend/.idea
apps/backend/.project
apps/backend/.classpath
apps/backend/.c9/
apps/backend/*.launch
apps/backend/.settings/
apps/backend/*.sublime-workspace

# IDE - VSCode
apps/backend/.vscode
apps/backend/.vscode/*
!apps/backend/.vscode/settings.json
!apps/backend/.vscode/tasks.json
!apps/backend/.vscode/launch.json
!apps/backend/.vscode/extensions.json

# dotenv environment variable files
apps/backend/.env
apps/backend/.env.development.local
apps/backend/.env.test.local
apps/backend/.env.production.local
apps/backend/.env.local

# temp directory
apps/backend/.temp
apps/backend/.tmp

# Runtime data
apps/backend/pids
apps/backend/*.pid
apps/backend/*.seed
apps/backend/*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
apps/backend/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
