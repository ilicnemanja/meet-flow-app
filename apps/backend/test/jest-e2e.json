{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@microsoft/graph/microsoft-graph/(.*)": "<rootDir>/../libs/microsoft-graph/src/$1",
    "@microsoft/graph/microsoft-graph": "<rootDir>/../libs/microsoft-graph/src"
  }
}