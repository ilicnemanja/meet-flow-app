# Server Configuration
PORT=3000

# Database Configuration
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Backend callback URL (must match the redirect URI in Azure)
MICROSOFT_REDIRECT_URI=

# Frontend URL for redirecting after authentication
FRONTEND_URL=
FRONTEND_REDIRECT_URI=

# JWT Secret (change this to a random string in production)
JWT_SECRET=

# Webhook Configuration
# IMPORTANT: Microsoft Graph webhooks require a public HTTPS URL
# For local development, use ngrok: ngrok http 3000
# Then set this to your ngrok HTTPS URL (e.g., https://abc123.ngrok.io)
WEBHOOK_BASE_URL=