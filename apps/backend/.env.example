# Server Configuration
PORT=3000

# Microsoft OAuth Configuration
# Get these values from Azure Portal: https://portal.azure.com
# App registrations > Your app > Overview
MICROSOFT_CLIENT_ID=your-client-id-here
MICROSOFT_CLIENT_SECRET=your-client-secret-here

# Backend callback URL (must match the redirect URI in Azure)
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Frontend URL for redirecting after authentication
FRONTEND_URL=http://localhost:5173
FRONTEND_REDIRECT_URI=http://localhost:5173/auth-callback

# JWT Secret (change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Webhook Configuration
# IMPORTANT: Microsoft Graph webhooks require a public HTTPS URL
# For local development, use ngrok: ngrok http 3000
# Then set this to your ngrok HTTPS URL (e.g., https://abc123.ngrok.io)
WEBHOOK_BASE_URL=http://localhost:3000
